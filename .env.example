# Dig runs locally with zero credentials.
# Copy to .env only when connecting real providers.

PORT=8787
DEMO_STAGE_PACING_MS=380

DATABASE_PATH=data/dig.db

# LLM is optional. mock keeps the annotation contract without a network call.
# Set LLM_PROVIDER=openai + LLM_API_KEY to also enable live collection's
# extraction step (turns search results into structured fields).
LLM_ENABLED=true
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Extra Groq keys, in order, after LLM_API_KEY. Used only when a key is rate-limited or rejected.
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK=
GROQ_API_KEY_FALLBACK_2=
GROQ_API_KEY_FALLBACK_3=
GROQ_API_KEY_FALLBACK_4=

# Live collection (a job created with live:true) needs both this and the
# OpenAI LLM settings above. Get a free key at https://tavily.com.
# One search call + one LLM extraction call per run — nothing more.
TAVILY_API_KEY=

# Jev decides trust and conflicts. The key is an OpenRouter key: https://openrouter.ai/keys
# Model: https://openrouter.ai/typesafe/jev-1.13
# Leave the key empty to use Dig's evidence rules. Demo mode never calls Jev.
TRUST_PROVIDER=jev
JEV_API_KEY=
JEV_MODEL=typesafe/jev-1.13
JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
# A decision below this confidence stays for a person. BOTH never auto-resolves.
JEV_AUTO_THRESHOLD=0.85

# Contact paths. Dig still publishes the row when every one of these is missing or failing.
# Hunter: https://hunter.io/api-keys  (free plan is 50 credits/month).
# Dig uses Domain Search for a company and Email Finder (Found) for a named person.
# One search each, cached 7 days. A miss is not charged. The verifier and enrichment
# endpoints are not called. 0 lifts the per-run cap; the account balance still applies.
HUNTER_ENABLED=true
HUNTER_API_KEY=
HUNTER_MAX_CALLS_PER_RUN=8
GITHUB_ENABLED=true
GITHUB_TOKEN=
PDL_ENABLED=false
PDL_API_KEY=
APOLLO_ENABLED=false
APOLLO_API_KEY=

# Enrichment runs after grounding, in parallel, and stops at this deadline with whatever it has.
ENRICHMENT_CONCURRENCY=
ENRICHMENT_TIMEOUT_MS=20000
ENRICHMENT_CACHE_TTL_MS=

# Outbound workflow connectors. mock records a preview and does not send.
EMAIL_CONNECTOR=mock
WHATSAPP_CONNECTOR=mock
LINKEDIN_CONNECTOR=mock

MAX_LLM_CALLS_PER_JOB=1
MAX_SOURCES=80
# Results kept per search run, for every intent (contact lookups follow it; each costs one Tavily credit).
RESULT_CAP=120
